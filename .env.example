# Tesla Fleet API application credentials (developer.tesla.com)
TESLA_CLIENT_ID=
TESLA_CLIENT_SECRET=
TESLA_REGION=na
TESLA_REDIRECT_URI=http://localhost:8080/callback

# Your vehicles: name=VIN pairs, comma-separated
TFC_VEHICLES=Model Y=YOUR_VIN_HERE,Model 3=SECOND_VIN_HERE

# The OpenAI-compatible server THIS app exposes
TFC_SERVER_HOST=127.0.0.1
TFC_SERVER_PORT=8642
# Optional: require Authorization: Bearer <key> on /v1/* (recommended if exposed on LAN)
TFC_SERVER_API_KEY=
TFC_MODEL_ID=tesla-fleet-chat

# Pluggable LLM backend — any OpenAI-compatible API. Default: local Ollama.
# Point at OpenAI, Groq, LM Studio, llama.cpp, ... or leave Ollama defaults.
# The app works FULLY without a backend (rules engine); the LLM only handles
# free-form questions. Vehicle data is sent only to this backend — nowhere else.
TFC_AI_BASE_URL=http://localhost:11434/v1
TFC_AI_API_KEY=
TFC_AI_MODEL=llama3.1
# auto = rules first, LLM for the rest | always = LLM first | never = rules only
TFC_AI_MODE=auto
TFC_AI_TIMEOUT_SECONDS=20

TFC_EMBEDDING_DIM=384
TFC_TOKEN_FILE=~/.tfc/tokens.json
# 1 = report commands instead of sending them
TFC_DRY_RUN=0
